[TEMPLATE]
DATABASE_URL=postgresql+psycopg://booking:booking@postgres:5432/booking
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
DEFAULT_CONVENIENCE_FEE_PAISE=2000
PUBLIC_BASE_URL=http://localhost:8000

# Shop logos. `local` writes to ./uploads (development); `s3` uploads to an
# S3-compatible bucket and is required on any host with an ephemeral disk.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
